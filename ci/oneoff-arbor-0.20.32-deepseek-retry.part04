        const val MAX_IMAGE_RESPONSE_BYTES = 96L * 1024 * 1024
        const val MAX_DEEPSEEK_TOOL_CORRECTION_RETRIES = 1
        const val DEEPSEEK_TOOL_CORRECTION_RETRY_DELAY_MS = 350L
