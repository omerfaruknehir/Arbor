<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="xylune_app_settings.xml" />
        <include domain="sharedpref" path="xylune_ui_session.xml" />
        <include domain="sharedpref" path="xylune_linux_runtime.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="xylune_app_settings.xml" />
        <include domain="sharedpref" path="xylune_ui_session.xml" />
        <include domain="sharedpref" path="xylune_linux_runtime.xml" />
    </device-transfer>
</data-extraction-rules>
