<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ArborWidgetButton" parent="android:style/Widget.Material.Button.Borderless.Small">
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textColor">@color/widget_accent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ArborCalculatorButton" parent="android:style/Widget.Material.Button.Borderless.Small">
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ArborScheduleRow" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
