<resources>
    <style name="Theme.Xylune" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Xylune.Launcher" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/xylune_splash_fallback</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/xylune_splash_fallback</item>
        <item name="android:navigationBarColor">@color/xylune_splash_fallback</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.Xylune.Launcher.Xylune" parent="Theme.Xylune.Launcher" />
    <style name="Theme.Xylune.Launcher.Graphite" parent="Theme.Xylune.Launcher" />
    <style name="Theme.Xylune.Launcher.Ocean" parent="Theme.Xylune.Launcher" />
    <style name="Theme.Xylune.Launcher.Violet" parent="Theme.Xylune.Launcher" />
    <style name="Theme.Xylune.Launcher.Sunset" parent="Theme.Xylune.Launcher" />
    <style name="Theme.Xylune.Launcher.System" parent="Theme.Xylune.Launcher">
        <item name="android:windowBackground">@color/xylune_splash_system</item>
        <item name="android:statusBarColor">@color/xylune_splash_system</item>
        <item name="android:navigationBarColor">@color/xylune_splash_system</item>
    </style>

</resources>
